@using HRSystem.Application.Dashboard

<section class="content-card employee-task-list" aria-label="@Title">
    <h2>@Title</h2>
    @if (Items.Count == 0)
    {
        <p class="muted">@EmptyText</p>
    }
    else
    {
        <div class="task-list">
            @foreach (var item in Items)
            {
                <a class="task-row" href="@item.Url">
                    <span class="task-category">@item.Category</span>
                    <span><strong>@item.Title</strong>@if (item.WorkDate.HasValue){<small>@item.WorkDate.Value.ToString("yyyy/MM/dd")</small>}</span>
                    <span>@item.Status</span>
                </a>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<EmployeeDashboardTaskDto> Items { get; set; } = [];
    [Parameter, EditorRequired] public string EmptyText { get; set; } = string.Empty;
}

<style>
    .employee-task-list h2 { margin-top: 0; font-size: 1.08rem; }
    .task-list { display: grid; }
    .task-row { display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: center; padding: .7rem 0; border-bottom: 1px solid var(--neutral-stroke-divider-rest); text-decoration: none; }
    .task-row:last-child { border-bottom: 0; }
    .task-row small { display: block; color: var(--neutral-foreground-hint); }
    .task-category { padding: .25rem .45rem; border-radius: 6px; background: var(--neutral-layer-3); }
</style>
