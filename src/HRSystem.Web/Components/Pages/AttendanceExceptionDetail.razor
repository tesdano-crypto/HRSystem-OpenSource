@page "/attendance-exceptions/{Id:guid}"
@attribute [Authorize(Policy = PolicyNames.AttendanceExceptionSelfService)]
@using HRSystem.Application.AttendanceExceptions
@using HRSystem.Domain.AttendanceExceptions
@inject IAttendanceExceptionService Service
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService Toast
<PageTitle>天然災害出勤豁免明細</PageTitle><PageHeader Title="天然災害出勤豁免明細" Description="顯示申請與 append-only 審核歷程；本申請不是請假。"/>
@if(!string.IsNullOrWhiteSpace(_error)){<FluentMessageBar Intent="@MessageIntent.Error">@_error</FluentMessageBar>}else if(_item is null){<LoadingState/>}else{<section class="detail-card"><div class="detail-heading"><h2>@_item.RequestNumber</h2><strong>@AttendanceExceptionRequests.StatusText(_item.Status)</strong></div><dl class="profile-grid"><div class="profile-item"><dt>員工</dt><dd>@_item.EmployeeNumber－@_item.EmployeeName</dd></div><div class="profile-item"><dt>日期</dt><dd>@_item.WorkDate</dd></div><div class="profile-item"><dt>原因</dt><dd>@AttendanceExceptionRequests.ReasonText(_item.ReasonType)</dd></div><div class="profile-item"><dt>影響</dt><dd>@AttendanceExceptionRequests.ImpactText(_item.ImpactType) @PeriodText(_item)</dd></div>@if(!string.IsNullOrWhiteSpace(_item.Reason)){<div class="profile-item full"><dt>說明</dt><dd>@_item.Reason</dd></div>}@if(_review is not null){<div class="profile-item"><dt>原始排班</dt><dd>@_review.ShiftSummary</dd></div><div class="profile-item"><dt>原始 Punch 摘要</dt><dd>@_review.RawPunchSummary</dd></div><div class="profile-item full"><dt>預計豁免後結果</dt><dd>@_review.ProjectedOutcomeSummary</dd></div>}</dl><FluentMessageBar Intent="@MessageIntent.Info">這是出勤豁免，不是請假；核准前不影響每日出勤。</FluentMessageBar><div class="form-actions">@if(_isOwner&&_item.Status==AttendanceExceptionStatus.Draft){<FluentButton Disabled="_busy" OnClick="BeginEdit">編輯草稿</FluentButton><FluentButton Appearance="@Appearance.Accent" Disabled="_busy" OnClick="@(()=>RunAsync(()=>Service.SubmitAsync(Action()),"申請已送出。"))">送出</FluentButton>}@if(_isOwner&&_item.Status==AttendanceExceptionStatus.Submitted){<FluentButton Disabled="_busy" OnClick="@(()=>RunAsync(()=>Service.WithdrawAsync(Action()),"申請已撤回。"))">撤回</FluentButton>}@if(_isOwner&&_item.Status==AttendanceExceptionStatus.Approved){<FluentButton Disabled="_busy" OnClick="@(()=>_mode="cancel")">申請取消</FluentButton>}@if(_canApprove&&!_isOwner&&_item.Status==AttendanceExceptionStatus.Submitted){<FluentButton Appearance="@Appearance.Accent" Disabled="_busy" OnClick="@(()=>RunAsync(()=>Service.ApproveAsync(Action()),"已核准並重新計算每日出勤。"))">核准</FluentButton><FluentButton Disabled="_busy" OnClick="@(()=>_mode="reject")">駁回</FluentButton>}@if(_canApprove&&!_isOwner&&_item.Status==AttendanceExceptionStatus.CancellationRequested){<FluentButton Appearance="@Appearance.Accent" Disabled="_busy" OnClick="@(()=>RunAsync(()=>Service.ApproveCancellationAsync(Action()),"取消已核准並重新計算每日出勤。"))">核准取消</FluentButton><FluentButton Disabled="_busy" OnClick="@(()=>_mode="reject-cancel")">駁回取消</FluentButton>}</div></section>
@if(_editing){<section class="editor-panel"><h2>編輯草稿</h2><EditForm Model="_edit" OnValidSubmit="SaveEditAsync"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><div class="field"><label>日期</label><InputDate @bind-Value="_edit.WorkDate"/></div><div class="field"><label>原因類型</label><InputSelect @bind-Value="_edit.ReasonType">@foreach(var reason in Enum.GetValues<NaturalDisasterReasonType>()){<option value="@reason">@AttendanceExceptionRequests.ReasonText(reason)</option>}</InputSelect></div><div class="field"><label>影響方式</label><InputSelect @bind-Value="_edit.ImpactType" @bind-Value:after="EditImpactChanged">@foreach(var impact in Enum.GetValues<AttendanceExceptionImpactType>()){<option value="@impact">@AttendanceExceptionRequests.ImpactText(impact)</option>}</InputSelect></div>@if(_edit.ImpactType==AttendanceExceptionImpactType.LateArrival){<div class="field"><label>豁免至</label><input type="time" @bind="_edit.ExemptToTime"/></div>}@if(_edit.ImpactType==AttendanceExceptionImpactType.EarlyDeparture){<div class="field"><label>自此時間起豁免</label><input type="time" @bind="_edit.ExemptFromTime"/></div>}<div class="field full"><label>補充說明</label><InputTextArea @bind-Value="_edit.Reason"/></div></div><div class="form-actions"><FluentButton OnClick="@(()=>_editing=false)">取消</FluentButton><FluentButton Appearance="@Appearance.Accent" Type="@ButtonType.Submit" Disabled="_busy">儲存</FluentButton></div></EditForm></section>}
@if(_mode is not null){<section class="editor-panel"><h2>請填寫原因</h2><textarea maxlength="1000" @bind="_reason" @bind:event="oninput"></textarea><div class="form-actions"><FluentButton OnClick="@(()=>_mode=null)">取消</FluentButton><FluentButton Appearance="@Appearance.Accent" Disabled="_busy" OnClick="ReasonActionAsync">確認</FluentButton></div></section>}
<section class="detail-card"><h2>處理歷程</h2>@if(_item.Histories.Count==0){<EmptyState Title="尚無處理歷程" Description="送出後會顯示歷程。"/>}else{<ol class="timeline">@foreach(var h in _item.Histories){<li><strong>@h.Action</strong><span>@TaipeiTime.Format(h.ActionAtUtc)－@h.ActionByDisplayName</span>@if(!string.IsNullOrWhiteSpace(h.Comment)){<p>@h.Comment</p>}</li>}</ol>}</section>}
@code{[Parameter]public Guid Id{get;set;}private AttendanceExceptionDto? _item;private AttendanceExceptionReviewContextDto? _review;private UpdateAttendanceExceptionDraftRequest _edit=new();private Guid? _employee;private bool _canApprove,_busy,_editing;private string? _error,_mode,_reason;private bool _isOwner=>_item?.EmployeeId==_employee;protected override async Task OnParametersSetAsync(){var state=await AuthenticationStateProvider.GetAuthenticationStateAsync();_employee=Guid.TryParse(state.User.FindFirst(HRSystem.Infrastructure.Identity.ApplicationUserClaimsPrincipalFactory.EmployeeIdClaimType)?.Value,out var id)?id:null;_canApprove=RolePermissions.HasPermission(state.User,PolicyNames.AttendanceExceptionApprove);await LoadAsync();}private async Task LoadAsync(){try{_item=await Service.GetDetailAsync(Id);_review=await Service.GetReviewContextAsync(Id);}catch(Exception ex){_error=ex.Message;}}private void BeginEdit(){_edit=new(){Id=Id,RowVersion=_item!.RowVersion,WorkDate=_item.WorkDate,ReasonType=_item.ReasonType,ImpactType=_item.ImpactType,ExemptFromTime=_item.ExemptFromTime,ExemptToTime=_item.ExemptToTime,Reason=_item.Reason};_editing=true;}private void EditImpactChanged(){if(_edit.ImpactType!=AttendanceExceptionImpactType.LateArrival)_edit.ExemptToTime=null;if(_edit.ImpactType!=AttendanceExceptionImpactType.EarlyDeparture)_edit.ExemptFromTime=null;}private async Task SaveEditAsync(){await RunAsync(()=>Service.UpdateDraftAsync(_edit),"草稿已更新。");_editing=false;}private AttendanceExceptionActionRequest Action()=>new(){Id=Id,RowVersion=_item!.RowVersion};private async Task ReasonActionAsync(){if(string.IsNullOrWhiteSpace(_reason)){_error="原因為必填欄位。";return;}var req=new AttendanceExceptionReasonActionRequest{Id=Id,RowVersion=_item!.RowVersion,Comment=_reason};await RunAsync(()=>_mode switch{"cancel"=>Service.RequestCancellationAsync(req),"reject"=>Service.RejectAsync(req),_=>Service.RejectCancellationAsync(req)},"處理完成。");_mode=null;_reason=null;}private async Task RunAsync(Func<Task<AttendanceExceptionDto>> action,string message){if(_busy)return;_busy=true;try{_item=await action();_error=null;Toast.ShowSuccess(message);}catch(Exception ex){_error=ex.Message;Toast.ShowError(_error);}finally{_busy=false;}}private static string PeriodText(AttendanceExceptionDto x)=>x.ImpactType switch{AttendanceExceptionImpactType.LateArrival=>$"（至 {x.ExemptToTime:HH\\:mm}）",AttendanceExceptionImpactType.EarlyDeparture=>$"（自 {x.ExemptFromTime:HH\\:mm}）",_=>string.Empty};}
