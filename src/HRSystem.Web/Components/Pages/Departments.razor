@page "/departments"
@attribute [Authorize(Policy = PolicyNames.EmployeeView)]
@using HRSystem.Application.Common.Exceptions
@using HRSystem.Application.Common.Models
@using HRSystem.Application.Departments
@inject IDepartmentService DepartmentService
@inject HRSystem.Application.Employees.IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject IToastService ToastService

<PageTitle>部門管理</PageTitle>
<PageHeader Title="部門管理" Description="管理公司部門、主管與啟用狀態。">
    <Actions>
        @if (_canEdit)
        {
            <FluentButton Appearance="@Appearance.Accent" OnClick="StartCreate">新增部門</FluentButton>
        }
    </Actions>
</PageHeader>

<div class="toolbar">
    <div class="field">
        <label for="department-keyword">關鍵字</label>
        <input id="department-keyword" @bind="_query.Keyword" placeholder="代碼或名稱" />
    </div>
    <div class="field">
        <label for="department-status">啟用狀態</label>
        <select id="department-status" @bind="_statusFilter">
            <option value="all">全部</option>
            <option value="active">啟用</option>
            <option value="inactive">停用</option>
        </select>
    </div>
    <FluentButton Appearance="@Appearance.Accent" OnClick="SearchAsync">搜尋</FluentButton>
</div>

@if (_editing)
{
    <section class="editor-panel" aria-label="部門編輯表單">
        <h2>@(_departmentForm.Id == Guid.Empty ? "新增部門" : "編輯部門")</h2>
        <EditForm Model="_departmentForm" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div class="field">
                    <label for="department-code">部門代碼</label>
                    <InputText id="department-code" @bind-Value="_departmentForm.Code" />
                    <ValidationMessage For="@(() => _departmentForm.Code)" />
                </div>
                <div class="field">
                    <label for="department-name">部門名稱</label>
                    <InputText id="department-name" @bind-Value="_departmentForm.Name" />
                    <ValidationMessage For="@(() => _departmentForm.Name)" />
                </div>
                @if (_departmentForm.Id != Guid.Empty)
                {
                    <div class="field full">
                        <label for="department-manager">部門主管</label>
                        <InputSelect id="department-manager" @bind-Value="_departmentForm.ManagerEmployeeId">
                            <option value="">尚未指定</option>
                            @foreach (var employee in _managerOptions)
                            {
                                <option value="@employee.Id">@employee.EmployeeNumber－@employee.ChineseName</option>
                            }
                        </InputSelect>
                    </div>
                }
            </div>
            <div class="form-actions">
                <FluentButton Appearance="@Appearance.Stealth" OnClick="CancelEdit">取消</FluentButton>
                <FluentButton Appearance="@Appearance.Accent" Type="@ButtonType.Submit" Disabled="_saving">儲存</FluentButton>
            </div>
        </EditForm>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <FluentMessageBar Intent="@MessageIntent.Error">@_error</FluentMessageBar>
}
else if (_loading)
{
    <LoadingState />
}
else if (_result is null || _result.Items.Count == 0)
{
    <EmptyState />
}
else
{
    <div class="grid-shell">
        <FluentDataGrid Items="@_result.Items.AsQueryable()" ResizableColumns="true">
            <PropertyColumn Property="@(x => x.Code)" Title="部門代碼" />
            <PropertyColumn Property="@(x => x.Name)" Title="部門名稱" />
            <PropertyColumn Property="@(x => x.ManagerName)" Title="主管" />
            <TemplateColumn Title="狀態" Context="item"><StatusBadge IsActive="item.IsActive" /></TemplateColumn>
            @if (_canEdit)
            {
                <TemplateColumn Title="操作" Context="item">
                    <div class="row-actions">
                        <FluentButton Appearance="@Appearance.Stealth" OnClick="@(() => StartEditAsync(item))">編輯</FluentButton>
                        <FluentButton Appearance="@Appearance.Stealth" OnClick="@(() => ToggleActiveAsync(item))">
                            @(item.IsActive ? "停用" : "啟用")
                        </FluentButton>
                    </div>
                </TemplateColumn>
            }
        </FluentDataGrid>
    </div>
    <Paginator PageNumber="_result.PageNumber" TotalPages="_result.TotalPages" TotalCount="_result.TotalCount" PageChanged="ChangePageAsync" />
}

@code {
    private readonly DepartmentQuery _query = new();
    private PagedResult<DepartmentDto>? _result;
    private UpdateDepartmentRequest _departmentForm = new();
    private IReadOnlyList<HRSystem.Application.Employees.EmployeeDto> _managerOptions = [];
    private string _statusFilter = "all";
    private string? _error;
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canEdit = RolePermissions.HasPermission(state.User, PolicyNames.EmployeeManage);
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _query.PageNumber = 1;
        _query.IsActive = _statusFilter switch { "active" => true, "inactive" => false, _ => null };
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        _query.PageNumber = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _result = await DepartmentService.GetListAsync(_query); }
        catch (Exception ex) { _error = Friendly(ex); }
        finally { _loading = false; }
    }

    private void StartCreate()
    {
        _departmentForm = new UpdateDepartmentRequest();
        _managerOptions = [];
        _editing = true;
    }

    private async Task StartEditAsync(DepartmentDto item)
    {
        _departmentForm = new UpdateDepartmentRequest
        {
            Id = item.Id, Code = item.Code, Name = item.Name,
            ManagerEmployeeId = item.ManagerEmployeeId, RowVersion = item.RowVersion
        };
        var employees = await EmployeeService.GetListAsync(new HRSystem.Application.Employees.EmployeeQuery
        {
            DepartmentId = item.Id, IsActive = true, PageSize = 100
        });
        _managerOptions = employees.Items;
        _editing = true;
    }

    private void CancelEdit() => _editing = false;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            if (_departmentForm.Id == Guid.Empty)
            {
                await DepartmentService.CreateAsync(new CreateDepartmentRequest
                {
                    Code = _departmentForm.Code, Name = _departmentForm.Name
                });
            }
            else
            {
                await DepartmentService.UpdateAsync(new UpdateDepartmentRequest
                {
                    Id = _departmentForm.Id, Code = _departmentForm.Code, Name = _departmentForm.Name,
                    ManagerEmployeeId = _departmentForm.ManagerEmployeeId, RowVersion = _departmentForm.RowVersion
                });
            }

            ToastService.ShowSuccess("部門資料已儲存。");
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = Friendly(ex);
            ToastService.ShowError(_error);
        }
        finally { _saving = false; }
    }

    private async Task ToggleActiveAsync(DepartmentDto item)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"確定要{(item.IsActive ? "停用" : "啟用")}部門「{item.Name}」嗎？",
            "確認", "取消", "變更部門狀態");
        var result = await dialog.Result;
        if (result.Cancelled) return;
        try
        {
            await DepartmentService.SetActiveAsync(item.Id, !item.IsActive, item.RowVersion);
            ToastService.ShowSuccess("部門狀態已更新。");
            await LoadAsync();
        }
        catch (Exception ex) { _error = Friendly(ex); ToastService.ShowError(_error); }
    }

    private static string Friendly(Exception ex) => ex switch
    {
        ApplicationValidationException or EntityNotFoundException or ConcurrencyConflictException or ForbiddenAccessException => ex.Message,
        _ => "處理部門資料時發生錯誤，請稍後再試。"
    };
}
