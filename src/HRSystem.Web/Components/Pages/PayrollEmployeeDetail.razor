  private string? PlanCodeFor(EmployeePayrollOverrideDto item)
  {
      if (_detail is null) return null;
      var itemEnd = item.EffectiveTo ?? DateOnly.MaxValue;
      var matches = _detail.Assignments
          .Where(x => x.IsActive && x.EffectiveFrom <= itemEnd &&
              (!x.EffectiveTo.HasValue || x.EffectiveTo.Value >= item.EffectiveFrom))
          .Select(x => x.PayrollPlanCode)
          .Distinct(StringComparer.Ordinal)
          .Take(2)
          .ToArray();
      return matches.Length == 1 ? matches[0] : null;
  }
