@page "/my-payslips"
@attribute [Authorize(Policy = PolicyNames.PayslipViewSelf)]
@using HRSystem.Application.Payroll
@inject IPayrollFinalizationService Finalizations

<PageTitle>我的薪資單</PageTitle>
<PageHeader Title="我的薪資單" Description="僅顯示本人已完成正式結算的薪資單。" />
@if (_loading) { <LoadingState /> }
else if (_items.Count == 0) { <EmptyState Title="尚無薪資單" Description="目前尚未有已發行的薪資單。" /> }
else
{
    <section class="content-card"><table class="data-table">
        <thead><tr><th>薪資年月</th><th>應發</th><th>扣款</th><th>實領</th><th>操作</th></tr></thead>
        <tbody>@foreach (var item in _items) { <tr>
            <td>@item.Year/@item.Month.ToString("00")</td><td>@item.GrossPay.ToString("N0")</td>
            <td>@item.TotalDeductions.ToString("N0")</td><td>@item.NetPay.ToString("N0")</td>
            <td><a href="/my-payslips/@item.Id">查看薪資單</a></td></tr> }</tbody>
    </table></section>
}
@code {
    private bool _loading = true;
    private IReadOnlyList<PayrollPayslipDto> _items = [];
    protected override async Task OnInitializedAsync()
    { try { _items = await Finalizations.GetMyPayslipsAsync(); } finally { _loading = false; } }
}
