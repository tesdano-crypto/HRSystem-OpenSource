    private static IReadOnlyList<AttendanceReviewResolutionReason> AvailableReasons(
        AttendanceReviewAnomalyType type) => type == AttendanceReviewAnomalyType.NonWorkingDayPunch
        ? [AttendanceReviewResolutionReason.NonWorkActivity, AttendanceReviewResolutionReason.PersonalReason,
            AttendanceReviewResolutionReason.IncorrectPunch, AttendanceReviewResolutionReason.Other]
        : type is
            AttendanceReviewAnomalyType.ExtendedStay or
            AttendanceReviewAnomalyType.PotentialUnreportedOvertime
        ?
        [
            AttendanceReviewResolutionReason.ConfirmedOvertimeWork,
            AttendanceReviewResolutionReason.NonWorkActivity,
            AttendanceReviewResolutionReason.PersonalReason,
            AttendanceReviewResolutionReason.WaitingForTransportation,
            AttendanceReviewResolutionReason.ReturnedToOfficeLater,
            AttendanceReviewResolutionReason.ForgotToClockOutEarlier,
            AttendanceReviewResolutionReason.IncorrectPunch,
            AttendanceReviewResolutionReason.Other
        ]
        :
        [
            AttendanceReviewResolutionReason.ConfirmedAttendance,
            AttendanceReviewResolutionReason.ApprovedLeave,
            AttendanceReviewResolutionReason.AuthorizedAdjustment,
            AttendanceReviewResolutionReason.AttendanceException,
            AttendanceReviewResolutionReason.DataCorrectionRequired,
            AttendanceReviewResolutionReason.IncorrectPunch,
