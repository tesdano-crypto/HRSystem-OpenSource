    private static IReadOnlyList<(string Text, string Css)> StatusBadges(
        AttendanceReviewRowDto item)
    {
        var badges = new List<(string, string)>();
        if (!item.IsRequiredWorkday) badges.Add(("非工作日", "neutral"));
        if (item.IsEmploymentSuspended) badges.Add(("留職停薪", "neutral"));
        if (item.IsAttendanceExempted) badges.Add(("出勤豁免", "success"));
        if (item.LeaveCoverageStatus == "Full") badges.Add(("全日請假", "success"));
        if (item.LeaveCoverageStatus == "Partial") badges.Add(("部分請假", "info"));
        if (item.IsLate) badges.Add(("遲到", "danger"));
        if (item.IsEarlyLeave) badges.Add(("早退", "danger"));
        if (item.MissingClockIn || item.MissingClockOut) badges.Add(("缺卡", "danger"));
        if (item.MissingMinutes > 0) badges.Add(("缺勤", "danger"));
        if (item.WorkedDuringApprovedLeaveMinutes > 0) badges.Add(("請假期間出勤", "warning"));
        if (item.OverstayLevel == AttendanceReviewOverstayLevel.ExtendedStay)
            badges.Add(("延後下班", "warning"));
        if (item.OverstayLevel == AttendanceReviewOverstayLevel.PotentialUnreportedOvertime)
            badges.Add(("疑似未申報加班", "danger"));
        if (item.Status == "NoShift") badges.Add(("無班別", "danger"));
        if (item.Status == "AmbiguousPunch") badges.Add(("打卡不明", "danger"));
        if (badges.Count == 0) badges.Add(("正常", "success"));
        return badges;
    }

