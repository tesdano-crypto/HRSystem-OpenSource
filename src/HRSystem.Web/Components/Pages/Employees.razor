@page "/employees"
@attribute [Authorize(Policy = PolicyNames.EmployeeView)]
@using HRSystem.Application.Common.Exceptions
@using HRSystem.Application.Common.Models
@using HRSystem.Application.Departments
@using HRSystem.Application.Employees
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject IToastService ToastService

<PageTitle>員工資料</PageTitle>
<PageHeader Title="員工資料" Description="查詢與維護員工基本資料及所屬部門。">
    <Actions>
        @if (_canEdit)
        {
            <FluentButton Appearance="@Appearance.Accent" OnClick="StartCreate">新增員工</FluentButton>
        }
    </Actions>
</PageHeader>

<div class="toolbar">
    <div class="field"><label for="employee-keyword">關鍵字</label><input id="employee-keyword" @bind="_query.Keyword" placeholder="編號或姓名" /></div>
    <div class="field">
        <label for="employee-department">部門</label>
        <select id="employee-department" @bind="_departmentFilter">
            <option value="">全部部門</option>
            @foreach (var department in _departments)
            {
                <option value="@department.Id">@department.Code－@department.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="employee-status">啟用狀態</label>
        <select id="employee-status" @bind="_statusFilter"><option value="all">全部</option><option value="active">啟用</option><option value="inactive">停用</option></select>
    </div>
    <FluentButton Appearance="@Appearance.Accent" OnClick="SearchAsync">搜尋</FluentButton>
</div>

@if (_editing)
{
    <section class="editor-panel" aria-label="員工編輯表單">
        <h2>@(_form.Id == Guid.Empty ? "新增員工" : "編輯員工")</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                @if (_form.Id == Guid.Empty)
                {
                    <div class="field full"><span>員工編號將於建立成功後由系統自動產生</span></div>
                }
                else
                {
                    <div class="field"><label for="employee-number">員工編號</label><output id="employee-number">@_editingEmployeeNumber</output></div>
                }
                <div class="field"><label for="employee-name">中文姓名</label><InputText id="employee-name" @bind-Value="_form.ChineseName" /><ValidationMessage For="@(() => _form.ChineseName)" /></div>
                <div class="field"><label for="employee-english-name">英文姓名</label><InputText id="employee-english-name" @bind-Value="_form.EnglishName" /></div>
                <div class="field">
                    <label for="employee-form-department">部門</label>
                    <InputSelect id="employee-form-department" @bind-Value="_form.DepartmentId">
                        <option value="">請選擇部門</option>
                        @foreach (var department in _departments.Where(x => x.IsActive))
                        {
                            <option value="@department.Id">@department.Code－@department.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="field"><label for="employee-title">職稱</label><InputText id="employee-title" @bind-Value="_form.JobTitle" /></div>
                <div class="field"><label for="employee-hire-date">到職日</label><InputDate id="employee-hire-date" @bind-Value="_form.HireDate" /></div>
                <div class="field"><label for="employee-termination-date">離職日</label><InputDate id="employee-termination-date" @bind-Value="_form.TerminationDate" /></div>
                <div class="field"><label for="employee-email">Email</label><InputText id="employee-email" @bind-Value="_form.Email" /><ValidationMessage For="@(() => _form.Email)" /></div>
                <div class="field"><label for="employee-mobile">手機</label><InputText id="employee-mobile" @bind-Value="_form.MobilePhone" /></div>
            </div>
            <div class="form-actions">
                <FluentButton Appearance="@Appearance.Stealth" OnClick="CancelEdit">取消</FluentButton>
                <FluentButton Appearance="@Appearance.Accent" Type="@ButtonType.Submit" Disabled="_saving">儲存</FluentButton>
            </div>
        </EditForm>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <FluentMessageBar Intent="@MessageIntent.Error">@_error</FluentMessageBar>
}
else if (_loading)
{
    <LoadingState />
}
else if (_result is null || _result.Items.Count == 0)
{
    <EmptyState />
}
else
{
    <div class="grid-shell">
        <FluentDataGrid Items="@_result.Items.AsQueryable()" ResizableColumns="true">
            <PropertyColumn Property="@(x => x.EmployeeNumber)" Title="員工編號" />
            <PropertyColumn Property="@(x => x.ChineseName)" Title="姓名" />
            <PropertyColumn Property="@(x => x.DepartmentName)" Title="部門" />
            <PropertyColumn Property="@(x => x.JobTitle)" Title="職稱" />
            <PropertyColumn Property="@(x => x.HireDate)" Title="到職日" Format="yyyy-MM-dd" />
            <TemplateColumn Title="狀態" Context="item"><StatusBadge IsActive="item.IsActive" /></TemplateColumn>
            @if (_canEdit)
            {
                <TemplateColumn Title="操作" Context="item">
                    <div class="row-actions">
                        <FluentButton Appearance="@Appearance.Stealth" OnClick="@(() => StartEdit(item))">編輯</FluentButton>
                        <FluentButton Appearance="@Appearance.Stealth" OnClick="@(() => ToggleActiveAsync(item))">@(item.IsActive ? "停用" : "啟用")</FluentButton>
                    </div>
                </TemplateColumn>
            }
        </FluentDataGrid>
    </div>
    <Paginator PageNumber="_result.PageNumber" TotalPages="_result.TotalPages" TotalCount="_result.TotalCount" PageChanged="ChangePageAsync" />
}

@code {
    private readonly EmployeeQuery _query = new();
    private PagedResult<EmployeeDto>? _result;
    private IReadOnlyList<DepartmentDto> _departments = [];
    private UpdateEmployeeRequest _form = NewForm();
    private string _departmentFilter = string.Empty;
    private string _statusFilter = "all";
    private string? _error;
    private string? _editingEmployeeNumber;
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canEdit = RolePermissions.HasPermission(state.User, PolicyNames.EmployeeManage);
        var departments = await DepartmentService.GetListAsync(new DepartmentQuery { PageSize = 100 });
        _departments = departments.Items;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _query.PageNumber = 1;
        _query.DepartmentId = Guid.TryParse(_departmentFilter, out var id) ? id : null;
        _query.IsActive = _statusFilter switch { "active" => true, "inactive" => false, _ => null };
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page) { _query.PageNumber = page; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { _result = await EmployeeService.GetListAsync(_query); }
        catch (Exception ex) { _error = Friendly(ex); }
        finally { _loading = false; }
    }

    private void StartCreate() { _form = NewForm(); _editingEmployeeNumber = null; _editing = true; }
    private void StartEdit(EmployeeDto item)
    {
        _form = new UpdateEmployeeRequest
        {
            Id = item.Id, ChineseName = item.ChineseName,
            EnglishName = item.EnglishName, DepartmentId = item.DepartmentId, JobTitle = item.JobTitle,
            HireDate = item.HireDate, TerminationDate = item.TerminationDate, Email = item.Email,
            MobilePhone = item.MobilePhone, RowVersion = item.RowVersion
        };
        _editingEmployeeNumber = item.EmployeeNumber;
        _editing = true;
    }

    private void CancelEdit() => _editing = false;

    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        try
        {
            if (_form.Id == Guid.Empty)
            {
                var created = await EmployeeService.CreateAsync(ToCreate(_form));
                ToastService.ShowSuccess($"員工已建立，員工編號：{created.EmployeeNumber}。");
            }
            else
            {
                await EmployeeService.UpdateAsync(_form);
                ToastService.ShowSuccess("員工資料已儲存。");
            }
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = Friendly(ex); ToastService.ShowError(_error); }
        finally { _saving = false; }
    }

    private async Task ToggleActiveAsync(EmployeeDto item)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"確定要{(item.IsActive ? "停用" : "啟用")}員工「{item.ChineseName}」嗎？",
            "確認", "取消", "變更員工狀態");
        var result = await dialog.Result;
        if (result.Cancelled) return;
        try
        {
            await EmployeeService.SetActiveAsync(item.Id, !item.IsActive, item.RowVersion);
            ToastService.ShowSuccess("員工狀態已更新。");
            await LoadAsync();
        }
        catch (Exception ex) { _error = Friendly(ex); ToastService.ShowError(_error); }
    }

    private static UpdateEmployeeRequest NewForm() => new() { HireDate = DateOnly.FromDateTime(DateTime.Today) };
    private static CreateEmployeeRequest ToCreate(UpdateEmployeeRequest x) => new()
    {
        ChineseName = x.ChineseName, EnglishName = x.EnglishName,
        DepartmentId = x.DepartmentId, JobTitle = x.JobTitle, HireDate = x.HireDate,
        TerminationDate = x.TerminationDate, Email = x.Email, MobilePhone = x.MobilePhone
    };
    private static string Friendly(Exception ex) => ex switch
    {
        ApplicationValidationException or EntityNotFoundException or ConcurrencyConflictException or ForbiddenAccessException
            or EmployeeNumberCapacityExceededException or EmployeeNumberGenerationException => ex.Message,
        HRSystem.Domain.Common.DomainValidationException => ex.Message,
        _ => "處理員工資料時發生錯誤，請稍後再試。"
    };
}
