@page "/account/change-password"
@attribute [Authorize(Policy = PolicyNames.EmployeeSelfService)]
@using HRSystem.Application.UserAccounts
@inject IToastService ToastService

<PageTitle>變更密碼｜<OrganizationTitle /></PageTitle>
<PageHeader Title="變更密碼" Description="變更完成後，登入 Cookie 會安全更新。" />

@if (Success)
{
    <FluentMessageBar Intent="@MessageIntent.Success">密碼已變更。</FluentMessageBar>
}
@if (!string.IsNullOrWhiteSpace(Error))
{
    <FluentMessageBar Intent="@MessageIntent.Error">@Error</FluentMessageBar>
}

<section class="editor-panel">
    <form method="post" action="/account/change-password/submit" data-enhance="false" class="account-form">
        <AntiforgeryToken />
        <div class="field"><label for="current-password">目前密碼</label><input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required /></div>
        <div class="field">
            <label for="new-password">新密碼</label>
            <input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="@InternalPasswordPolicy.MinimumLength" required />
            <small>至少 4 個字元，不限制大小寫、數字或特殊字元。</small>
        </div>
        <div class="field"><label for="confirm-password">確認新密碼</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="@InternalPasswordPolicy.MinimumLength" required /></div>
        <button class="primary-button" type="submit">儲存新密碼</button>
    </form>
</section>

@code {
    [SupplyParameterFromQuery] public bool Success { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private bool _toastShown;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Success && !_toastShown)
        {
            _toastShown = true;
            ToastService.ShowSuccess("密碼已變更。");
        }
    }
}
